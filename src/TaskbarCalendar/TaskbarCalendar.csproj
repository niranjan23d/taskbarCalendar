<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Framework 4.8.1 ships with Windows 11, so the EXE needs nothing else installed. -->
    <TargetFramework>net481</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TaskbarCalendar</RootNamespace>
    <AssemblyName>TaskbarCalendar</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <Version>2.2.4</Version>
    <Product>Taskbar Calendar</Product>
    <Description>Classic Outlook meetings on the Windows 11 taskbar</Description>
    <Copyright>Copyright (c) 2026 Taskbar Calendar contributors. Includes upstream MIT-licensed work.</Copyright>
    <Company>Taskbar Calendar contributors</Company>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\icon.ico" LogicalName="icon.ico" />
    <EmbeddedResource Include="..\..\assets\fugue\calendar-small.png" LogicalName="fugue.calendar-small.png" />
    <EmbeddedResource Include="..\..\assets\fugue\calendar-day.png" LogicalName="fugue.calendar-day.png" />
    <EmbeddedResource Include="..\..\assets\fugue\balloon.png" LogicalName="fugue.balloon.png" />
    <EmbeddedResource Include="..\..\assets\fugue\cross-circle.png" LogicalName="fugue.cross-circle.png" />
    <EmbeddedResource Include="..\..\assets\fugue\category-group.png" LogicalName="fugue.category-group.png" />
    <EmbeddedResource Include="..\..\assets\fugue\book.png" LogicalName="fugue.book.png" />
    <EmbeddedResource Include="..\..\assets\fugue\bug.png" LogicalName="fugue.bug.png" />
    <EmbeddedResource Include="..\..\assets\fugue\processor.png" LogicalName="fugue.processor.png" />
    <EmbeddedResource Include="..\..\assets\fugue\gear.png" LogicalName="fugue.gear.png" />
    <EmbeddedResource Include="..\..\assets\fugue\color.png" LogicalName="fugue.color.png" />
    <EmbeddedResource Include="..\..\assets\fugue\paint-can.png" LogicalName="fugue.paint-can.png" />
    <EmbeddedResource Include="..\..\assets\fugue\arrow-circle-double.png" LogicalName="fugue.arrow-circle-double.png" />
    <EmbeddedResource Include="..\..\assets\fugue\tick.png" LogicalName="fugue.tick.png" />
    <EmbeddedResource Include="..\..\assets\fugue\cross.png" LogicalName="fugue.cross.png" />
    <EmbeddedResource Include="..\..\assets\fugue\folder-open.png" LogicalName="fugue.folder-open.png" />
    <EmbeddedResource Include="..\..\assets\fugue\document-text.png" LogicalName="fugue.document-text.png" />
    <EmbeddedResource Include="..\..\assets\fugue\clock.png" LogicalName="fugue.clock.png" />
    <EmbeddedResource Include="..\..\assets\fugue\door-open-in.png" LogicalName="fugue.door-open-in.png" />
    <EmbeddedResource Include="..\..\assets\fugue\beaker.png" LogicalName="fugue.beaker.png" />
    <EmbeddedResource Include="..\..\assets\fugue\briefcase.png" LogicalName="fugue.briefcase.png" />
    <EmbeddedResource Include="..\..\assets\fugue\chart.png" LogicalName="fugue.chart.png" />
    <EmbeddedResource Include="..\..\assets\fugue\clipboard-task.png" LogicalName="fugue.clipboard-task.png" />
    <EmbeddedResource Include="..\..\assets\fugue\cup.png" LogicalName="fugue.cup.png" />
    <EmbeddedResource Include="..\..\assets\fugue\database.png" LogicalName="fugue.database.png" />
    <EmbeddedResource Include="..\..\assets\fugue\globe.png" LogicalName="fugue.globe.png" />
    <EmbeddedResource Include="..\..\assets\fugue\heart.png" LogicalName="fugue.heart.png" />
    <EmbeddedResource Include="..\..\assets\fugue\home.png" LogicalName="fugue.home.png" />
    <EmbeddedResource Include="..\..\assets\fugue\money.png" LogicalName="fugue.money.png" />
    <EmbeddedResource Include="..\..\assets\fugue\music.png" LogicalName="fugue.music.png" />
    <EmbeddedResource Include="..\..\assets\fugue\projection-screen-presentation.png" LogicalName="fugue.projection-screen-presentation.png" />
    <EmbeddedResource Include="..\..\assets\fugue\rocket.png" LogicalName="fugue.rocket.png" />
    <EmbeddedResource Include="..\..\assets\fugue\shield.png" LogicalName="fugue.shield.png" />
    <EmbeddedResource Include="..\..\assets\fugue\target.png" LogicalName="fugue.target.png" />
