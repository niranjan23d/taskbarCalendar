  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TaskbarCalendar.Tests" />
  </ItemGroup>

  <!-- Keep the hand-off EXE current when this project is rebuilt from Visual Studio. -->
  <Target Name="CopyTaskbarCalendarToDist" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\..\dist" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildProjectDirectory)\..\..\dist\TaskbarCalendar.exe" SkipUnchangedFiles="false" />
  </Target>

</Project>
